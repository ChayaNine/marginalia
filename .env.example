# Copy this file to .env and fill in what you need.

# SQLite database file, relative to the project root. This is also the default
# when the variable is unset.
DATABASE_URL="file:./dev.db"

# Leave this empty to run in DEMO MODE: a deterministic local stand-in for a
# model, so the whole app works offline and costs nothing. Demo answers quote the
# best-matching sentences; a real model writes explanations.
# Set a key to use OpenAI embeddings + chat completions.
OPENAI_API_KEY=""

# Optional overrides.
# AI_PROVIDER="openai" | "mock"   (default: openai if a key or base URL is set, otherwise mock)
# OPENAI_CHAT_MODEL="gpt-4o-mini"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# MAX_UPLOAD_MB="10"

# Any OpenAI-compatible server works through OPENAI_BASE_URL. Examples (check each
# provider's docs for current model names):
#
#   Ollama, free and local (ollama pull llama3.1 && ollama pull nomic-embed-text):
#     OPENAI_BASE_URL="http://localhost:11434/v1"
#     OPENAI_CHAT_MODEL="llama3.1"
#     OPENAI_EMBEDDING_MODEL="nomic-embed-text"
#
#   Google Gemini (key from Google AI Studio):
#     OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
#     OPENAI_API_KEY="your-gemini-key"
#     OPENAI_CHAT_MODEL="<a current Gemini Flash model>"
#     OPENAI_EMBEDDING_MODEL="gemini-embedding-001"
#
#   Services with chat but no embeddings endpoint (e.g. Groq, OpenRouter): keep
#   search offline and use the model only for answers:
#     EMBEDDING_PROVIDER="local"
